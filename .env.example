# Development site only. The exact site origin from your browser, without a path.
# Plain http is accepted only for loopback hosts (localhost, *.localhost, 127.0.0.0/8, ::1).
FRAPPE_URL=http://127.0.0.1:8000
# API key/secret of a dedicated, restricted, non-Administrator user. Never commit real values.
FRAPPE_API_KEY=replace-with-restricted-user-api-key
FRAPPE_API_SECRET=replace-with-restricted-user-api-secret
# Deny by default: only these DocTypes (comma-separated, exact names) can be read.
MCP_ALLOWED_DOCTYPES=ToDo
# Optional JSON: extra fields per allowed DocType; `name` is always returned, nothing else by default.
# MCP_ALLOWED_FIELDS={"ToDo": ["status", "priority", "date"]}
# Optional: logical site label shown to clients, per-request deadline (1-60 s).
# MCP_SITE_ID=default
# FRAPPE_TIMEOUT_SECONDS=15
MCP_LOG_LEVEL=INFO
